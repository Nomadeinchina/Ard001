#include <LiquidCrystal.h>
LiquidCrystal lcd(12, 11, 5, 4, 3, 2);

void setup() {
  lcd.begin(16, 2);
  lcd.print("Hola Mundo");
}

void loop() {
  lcd.noDisplay(); // Apaga el texto
  delay(500);      // Espera medio segundo
  lcd.display();   // Enciende el texto
  delay(500);      // Espera medio segundo
}
